[Unit]
Description=RobotPi Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/bin/java -jar /home/pi/RobotPiServer-0.0.1-SNAPSHOT-jar-with-dependencies.jar
StandardOutput=append:/var/log/robotpi.log
StandardError=append:/var/log/robotpi.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
